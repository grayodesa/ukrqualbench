# UkrQualBench Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# API Keys
# ============================================================================
# UkrQualBench uses prefixed variables (UKRQUALBENCH_*) for centralized config.
# For compatibility, model clients also accept standard SDK variable names.

# OpenAI
# Prefixed (for UkrQualBench config):
UKRQUALBENCH_OPENAI_API_KEY=sk-...
# Standard (fallback for direct client usage):
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# Prefixed:
UKRQUALBENCH_ANTHROPIC_API_KEY=sk-ant-...
# Standard:
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Gemini)
# Prefixed:
UKRQUALBENCH_GOOGLE_API_KEY=...
# Standard (new SDK prefers GEMINI_API_KEY):
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...  # legacy, still supported

# OpenRouter (unified gateway — use explicit `openrouter:` model prefix to route here,
# e.g. `openrouter:openai/gpt-5.2` or `openrouter:google/gemma-3-27b-it`).
# Without the prefix, model ids fall through to the legacy heuristic and HF-style
# ids like `google/gemma-3-27b-it` are routed to the LOCAL endpoint instead.
# Prefixed:
# UKRQUALBENCH_OPENROUTER_API_KEY=sk-or-...
# Standard:
# OPENROUTER_API_KEY=sk-or-...
# App attribution headers (optional, defaulted to UkrQualBench):
# UKRQUALBENCH_OPENROUTER_REFERER=https://github.com/UkrQualBench/UkrQualBench
# UKRQUALBENCH_OPENROUTER_TITLE=UkrQualBench

# Azure OpenAI (optional, for Azure deployment)
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Google Cloud / Vertex AI (optional, for Vertex deployment)
# GOOGLE_CLOUD_PROJECT=your-project-id

# HuggingFace (for gated datasets like FLORES+)
# Prefixed:
# UKRQUALBENCH_HUGGINGFACE_TOKEN=hf_...
# Standard:
# HF_TOKEN=hf_...
# HUGGINGFACE_TOKEN=hf_...

# ============================================================================
# Local Model Configuration
# ============================================================================

# OpenAI-compatible local server (LM Studio, LocalAI, llama.cpp server, etc.)
# Default port for LM Studio is 1234. Used for any model id that doesn't match
# a cloud provider prefix — including Gemma (e.g. google/gemma-4-26b-a4b).
# UKRQUALBENCH_LOCAL_BASE_URL=http://localhost:1234/v1

# Ollama
# Prefixed (also accepted as alias for LOCAL_BASE_URL):
UKRQUALBENCH_OLLAMA_BASE_URL=http://localhost:11434
# Standard (also supported):
# OLLAMA_HOST=http://localhost:11434

# vLLM (optional)
# VLLM_API_KEY=
# VLLM_BASE_URL=http://localhost:8000

# ============================================================================
# Benchmark Settings
# ============================================================================
UKRQUALBENCH_BENCHMARK_VERSION=lite  # lite, base, or large
UKRQUALBENCH_DEFAULT_JUDGE=gemini-3.1-flash-lite

# ============================================================================
# ELO Rating Settings
# ============================================================================
UKRQUALBENCH_ELO_INITIAL_RATING=1500
UKRQUALBENCH_ELO_K_FACTOR=32

# ============================================================================
# Execution Settings
# ============================================================================
UKRQUALBENCH_MAX_CONCURRENT_REQUESTS=10
UKRQUALBENCH_REQUEST_TIMEOUT=60
UKRQUALBENCH_TEMPERATURE=0.0

# Rate limiting
UKRQUALBENCH_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================================
# Budget Controls (optional)
# ============================================================================
# UKRQUALBENCH_MAX_COST_USD=50.0
UKRQUALBENCH_BUDGET_WARNING_THRESHOLD=0.8

# ============================================================================
# Checkpoint Settings
# ============================================================================
UKRQUALBENCH_CHECKPOINT_INTERVAL=100
UKRQUALBENCH_AUTO_RESUME=true

# ============================================================================
# Paths
# ============================================================================
UKRQUALBENCH_DATA_DIR=data
UKRQUALBENCH_RESULTS_DIR=results

# ============================================================================
# Circuit Breaker Settings
# ============================================================================
UKRQUALBENCH_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
UKRQUALBENCH_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
UKRQUALBENCH_CIRCUIT_BREAKER_TIMEOUT=60

# ============================================================================
# Retry Settings
# ============================================================================
UKRQUALBENCH_MAX_RETRIES=5
UKRQUALBENCH_RETRY_BASE_DELAY=1.0
